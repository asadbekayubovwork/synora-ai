# Copy to `.env` only to point somewhere other than the defaults, which are
# already right for both cases: `pnpm dev` talks to a locally run API, and a
# production build talks to https://back.synora-ai.uz/api/v1.

# Where the browser calls the API. Must be reachable from the browser, and the
# API's CORS_ORIGINS must list this app's origin.
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# Optional: overrides the above during SSR only, for deployments where the Nuxt
# server reaches the API on an internal address the browser cannot resolve.
# NUXT_API_BASE=http://synora-api:8000/api/v1
